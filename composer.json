{
  "name": "dravencms/recaptcha",
  "type": "dravencms-package",
  "description": "DravenCMS Recaptcha",
  "keywords": [
    "dravencms",
    "recaptcha"
  ],
  "license": [
    "LGPL-3.0"
  ],
  "authors": [
    {
      "name": "Adam Schubert"
    }
  ],
  "provides": {
    "dravencms/captcha-implementation": "*"
  },
  "require": {
    "dravencms/icaptcha": "*",
    "contributte/recaptcha": "^4.0.2"
  },
  "autoload": {
    "psr-4": {
      "Dravencms\\ReCaptcha\\": "src/"
    }
  },
  "extra": {
    "dravencms": {
      "configuration": {
        "extensions": {
          "recaptcha": "Dravencms\\ReCaptcha\\DI\\ReCaptchaExtension"
        }
      }
    }
  }
}
